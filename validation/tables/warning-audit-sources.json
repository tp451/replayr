  },
  {
    "url": "https://github.com/Nitrofski/psxjin/blob/534fd3856913c3198e649806a91db5c232e4d34a/psxjin/movie.h",
    "sha256": "e28c19e476bbd3268dbeba0acd87454a98198d02d7927b0ff82ca67d65683ecb",
    "evidence": "Lines4-6 define standard-pad15 and analog-pad33 text field widths including their separator."
  },
  {
